{
  "seed": 42,
  "lambda_cost": 0.0001,
  "verifier_threshold": 0.5,
  "llm": {
    "mode": "openai_compatible",
    "base_url": "http://127.0.0.1:8000/v1",
    "api_key_env": "OPENAI_API_KEY",
    "model_name": "Qwen3-8B-Instruct",
    "local_model_path": "Qwen/Qwen3-8B-Instruct",
    "temperature": 0.0,
    "max_tokens": 512,
    "timeout": 120,
    "enable_thinking": true
  },
  "data": {
    "train_split": "train",
    "eval_split": "test",
    "train_limit": null,
    "eval_limit": null,
    "data_path": "data/gsm8k_train.jsonl",
    "eval_data_path": "data/gsm8k_test.jsonl"
  },
  "outputs": {
    "policy_dataset": "outputs/policy_dataset.jsonl",
    "policy_model": "outputs/policy_model.pkl",
    "eval_results": "outputs/eval_results.json"
  },
  "verifier": {
    "mode": "llm",
    "use_main_llm": false,
    "llm": {
      "mode": "openai_compatible",
      "base_url": "http://127.0.0.1:8002/v1",
      "api_key_env": "OPENAI_API_KEY",
      "model_name": "Qwen3-4B-Instruct",
      "local_model_path": "Qwen/Qwen3-4B-Instruct",
      "temperature": 0.0,
      "max_tokens": 256,
      "timeout": 120
    },
    "temperature": 0.0,
    "max_tokens": 256,
    "fallback_to_rule": true
  },
  "base_llm": {
    "mode": "openai_compatible",
    "base_url": "http://127.0.0.1:8000/v1",
    "api_key_env": "OPENAI_API_KEY",
    "model_name": "Qwen3-8B-Instruct",
    "local_model_path": "Qwen/Qwen3-8B-Instruct",
    "temperature": 0.0,
    "max_tokens": 512,
    "timeout": 120,
    "enable_thinking": true
  },
  "reflector_llm": {
    "mode": "openai_compatible",
    "base_url": "http://127.0.0.1:8001/v1",
    "api_key_env": "OPENAI_API_KEY",
    "model_name": "DeepSeek-R1-Distill-Qwen-7B",
    "local_model_path": "deepseek-ai/DeepSeek-R1-Distill-Qwen-7B",
    "temperature": 0.0,
    "max_tokens": 512,
    "timeout": 120
  },
  "qa_f1_threshold": 0.8
}
