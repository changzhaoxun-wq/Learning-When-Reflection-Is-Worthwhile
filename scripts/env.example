# Copy to .env.local or source it after replacing the placeholders.
# The shell entry points also accept these values directly as environment variables.

export OPENAI_API_KEY="EMPTY"
export BASE_URL="http://127.0.0.1:8000/v1"
export REFLECTOR_URL="http://127.0.0.1:8001/v1"
export BASE_MODEL="Qwen/Qwen3-8B-Instruct"
export REFLECTOR_MODEL="deepseek-ai/DeepSeek-R1-Distill-Qwen-7B"
export BASE_PATH="${BASE_MODEL}"
export REFLECTOR_PATH="${REFLECTOR_MODEL}"
export ENCODER_NAME="Qwen/Qwen3-0.6B"

# Set these to local JSONL files before running real generation.
export TRAIN_DATA="/path/to/gsm8k/train.jsonl"
export TEST_DATA="/path/to/gsm8k/test.jsonl"
